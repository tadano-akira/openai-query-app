# 例。実際の langfuse/.env は scripts/init_env.py で生成する
LANGFUSE_VERSION=4.56.0
NEXTAUTH_SECRET=changeme
SALT=changeme
ENCRYPTION_KEY=changeme
POSTGRES_PASSWORD=changeme
CLICKHOUSE_PASSWORD=changeme
REDIS_AUTH=changeme
MINIO_ROOT_PASSWORD=changeme

# 初回起動時に自動作成される org / project / user
LANGFUSE_INIT_PROJECT_ID=oqa-local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=changeme
LANGFUSE_INIT_PROJECT_SECRET_KEY=changeme
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_PASSWORD=changeme
