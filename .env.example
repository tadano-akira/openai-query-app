# アプリ用設定の例。実際の .env は scripts/init_env.py で生成する
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# 画面で選択できるモデル（カンマ区切り、省略時は既定の候補）
# OPENAI_MODELS=gpt-5.5,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,gpt-4.1,gpt-4.1-mini

POSTGRES_PASSWORD=changeme

# Langfuse（langfuse/.env と同じキー）
LANGFUSE_PUBLIC_KEY=changeme
LANGFUSE_SECRET_KEY=changeme
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=oqa-local

# バックアップ（scripts/backup.sh）
BACKUP_PUBLIC_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PREFIX=openai-query-app
# BACKUP_RETENTION_DAYS=30
# BACKUP_HEARTBEAT_URL=
